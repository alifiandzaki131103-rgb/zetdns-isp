# PENTING: src/bin/* TIDAK diabaikan.
# Binary sengaja diikutkan supaya repo self-contained (opsi A).
# Cuma ~26 MB, dan itu inti fitur CDB.

# Rahasia — jangan pernah commit
*.key
*.crt
*.pem
config.json
session_key*
*password*
*secret*

# Backup lokal
*.before-*
*.bak
*~

# Data CDB / daftar domain (ratusan MB, jangan masuk git)
blacklist.db*
trust.txt*
trust.txt.raw
*.cdb

# CATATAN: rpz.safesearch JANGAN di-ignore.
# Dia cuma ~20 KB, tapi WAJIB ada: safesearch.conf menunjuk zonefile ini.
# Kalau hilang, unbound mati dengan "fatal error: Could not setup authority
# zones". Sebelum di-un-ignore, file ini tidak pernah masuk repo dan instalasi
# baru selalu gagal begitu SafeSearch dinyalakan dari dashboard.

# Log & runtime
*.log
run/
metrics.db*

# Sistem
.DS_Store
Thumbs.db
