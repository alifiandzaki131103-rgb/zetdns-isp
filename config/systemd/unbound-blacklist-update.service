[Unit]
Description=Update DNS Trust Komdigi blacklist
After=network-online.target
Wants=network-online.target
# JANGAN Requires=dnstrust-unbound. Restart unbound (Restart=on-failure 2s,
# atau toggle TPROXY/num-threads) mengirim SIGTERM ke updater yang sedang
# unduh CDB ~70s (exit 143), daftar Komdigi tidak pernah selesai. After=
# cukup: jalankan sesudah unbound kalau unbound sudah up, jangan bunuh
# unduhan kalau unbound restart.

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/unbound-blacklist-update
ExecStart=/usr/local/sbin/update-dnstrust-blacklist
TimeoutStartSec=20min
UMask=0027
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
